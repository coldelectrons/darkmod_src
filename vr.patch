+void DepthStage::FastDepthPass( const idList<drawSurf_t *> drawSurfs, const viewDef_t *viewDef ) {
+	if ( drawSurfs.Num() == 0 ) {
+		return;
+	}
+
+	if ( r_ignore.GetBool() ) {
+		GenericDepthPass( drawSurfs, viewDef );
+		return;
